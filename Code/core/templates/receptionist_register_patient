{% extends 'base.html' %}
{% load static %}

{% block title %}Register Patient - MediSync SA{% endblock %}

{% block extra_css %}
<style>
    .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important; }

    .page-bg {
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        min-height: calc(100vh - 76px);
        padding: 40px 0;
    }
    .page-bg .sparkle {
        position: absolute; width: 6px; height: 6px;
        background: white; border-radius: 50%;
        box-shadow: 0 0 10px rgba(255,255,255,0.7), 0 0 20px rgba(167,139,250,0.5);
        animation: floatGlitter linear infinite; opacity: 0;
    }
    .page-bg .sparkle:nth-child(1) { left: 5%; top: 10%; animation-duration: 6s; }
    .page-bg .sparkle:nth-child(2) { left: 25%; top: 40%; animation-duration: 8s; animation-delay: 1s; }
    .page-bg .sparkle:nth-child(3) { left: 60%; top: 70%; animation-duration: 7s; animation-delay: 2s; }
    .page-bg .sparkle:nth-child(4) { left: 85%; top: 20%; animation-duration: 9s; animation-delay: 0.5s; }

    @keyframes floatGlitter {
        0%   { transform: translateY(0) scale(0.5); opacity: 0; }
        30%  { opacity: 1; transform: translateY(-40px) scale(1.2); }
        70%  { opacity: 0.8; transform: translateY(-80px) scale(0.8); }
        100% { transform: translateY(-120px) scale(0.3); opacity: 0; }
    }

    .page-content { position: relative; z-index: 2; }

    .breadcrumb-nav {
        display: flex; align-items: center; gap: 10px;
        color: rgba(255,255,255,0.7); font-size: 0.85rem; margin-bottom: 20px;
    }
    .breadcrumb-nav a { color: rgba(255,255,255,0.7); text-decoration: none; }
    .breadcrumb-nav a:hover { color: white; }

    .page-title { text-align: center; color: white; margin-bottom: 30px; }
    .page-title h1 {
        font-weight: 800; font-size: 1.8rem;
        background: linear-gradient(135deg, #a78bfa, #f0abfc);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .glass-card {
        background: rgba(255,255,255,0.98);
        border-radius: 22px;
        padding: 35px 40px;
        box-shadow: 0 15px 45px rgba(0,0,0,0.25);
    }

    .form-label-custom {
        font-size: 0.8rem; font-weight: 700; color: #1a1a2e;
        text-transform: uppercase; letter-spacing: 1px;
        margin-bottom: 8px; display: block;
    }
    .form-control, .form-select {
        border-radius: 12px; border: 2px solid #e8eaf2;
        padding: 12px 16px; font-size: 0.95rem;
        background: #f8f9fc; transition: all 0.3s;
    }
    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102,126,234,0.12);
        background: white;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none; color: white; border-radius: 12px;
        padding: 14px 28px; font-weight: 700; font-size: 1rem;
        transition: all 0.3s; cursor: pointer;
        display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(102,126,234,0.45);
        color: white;
    }
    .btn-outline-gradient {
        background: transparent; border: 2px solid #667eea;
        color: #667eea; border-radius: 12px;
        padding: 12px 24px; font-weight: 700;
        transition: all 0.3s; text-decoration: none;
        display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-outline-gradient:hover {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white; border-color: transparent;
    }
</style>
{% endblock %}

{% block content %}

<div class="page-bg position-relative">
    <span class="sparkle"></span><span class="sparkle"></span><span class="sparkle"></span>
    <span class="sparkle"></span>

    <div class="container page-content">

        <div class="breadcrumb-nav">
            <a href="{% url 'core:staff_dashboard' %}"><i class="fas fa-home me-1"></i> Dashboard</a>
            <i class="fas fa-chevron-right" style="font-size: 0.7rem;"></i>
            <span style="color: white; font-weight: 600;">Register Patient</span>
        </div>

        <div class="page-title">
            <h1><i class="fas fa-user-plus me-2"></i>Register New Patient</h1>
            <p class="text-white-50">Register a patient on their behalf</p>
        </div>

        {% if messages %}
            {% for message in messages %}
                <div class="alert alert-{{ message.tags }} alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endif %}

        <div class="glass-card">
            <form method="POST">
                {% csrf_token %}

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">SA ID Number *</label>
                        {{ form.sa_id_number }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Date of Birth *</label>
                        {{ form.date_of_birth }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">First Name *</label>
                        {{ form.first_name }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Surname *</label>
                        {{ form.last_name }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Email *</label>
                        {{ form.email }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Phone Number *</label>
                        {{ form.phone_number }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Password *</label>
                        {{ form.password1 }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Confirm Password *</label>
                        {{ form.password2 }}
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4 flex-wrap">
                    <button type="submit" class="btn-gradient">
                        <i class="fas fa-save"></i> Register Patient
                    </button>
                    <a href="{% url 'core:staff_dashboard' %}" class="btn-outline-gradient">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}